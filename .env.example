# From @BotFather
BOT_TOKEN=123456:ABC...
# Optional. Free tier works for a friend group (60 requests/min, ~2000/day).
OPENDOTA_API_KEY=
# Optional. Backup for when OpenDota is down (match lists and whole matches).
# Free at https://stratz.com/api (log in with Steam). Use it on one server only:
# STRATZ allows a key from at most 2 IP addresses per 15 minutes.
STRATZ_API_KEY=
DB_PATH=bot.sqlite3
LOG_LEVEL=INFO
